local draggingStrength = false
local strengthInputType
local function setStrengthFromX(x)
    local width = math.max(strengthTrack.AbsoluteSize.X, 1)
    local ratio = math.clamp((x - strengthTrack.AbsolutePosition.X) / width, 0, 1)
    Settings.Strength = math.clamp(math.floor(1 + ratio * 99 + 0.5), 1, 100)
    local normalized = (Settings.Strength - 1) / 99
    strengthFill.Size = UDim2.new(normalized, 0, 1, 0)
    strengthKnob.Position = UDim2.new(normalized, 0, 0.5, 0)
    strengthValue.Text = tostring(Settings.Strength)
end

connect(strengthTrack.InputBegan, function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        draggingStrength = true
        strengthInputType = input.UserInputType
        setStrengthFromX(input.Position.X)
    end
end)

connect(UserInputService.InputChanged, function(input)
    if not draggingStrength then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        setStrengthFromX(input.Position.X)
    end
end)

connect(UserInputService.InputEnded, function(input)
    if not draggingStrength then return end
    if input.UserInputType == strengthInputType
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingStrength = false
        strengthInputType = nil
    end
end)

