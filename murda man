        if button:IsA("TextButton") and button.Name == (CurrentPage and CurrentPage.Name) then
            button.BackgroundColor3 = color
            button.TextColor3 = BG
        end
    end
end

local npcCache = {}

local function registerNPCFromHumanoid(humanoid)
    if not humanoid or not humanoid:IsA("Humanoid") then return end
    local model = humanoid.Parent
    if model and model:IsA("Model") and not Players:GetPlayerFromCharacter(model)
        and model ~= LocalPlayer.Character
        and model:GetAttribute("LockOnTargetable") ~= false then
        npcCache[model] = true
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("Humanoid") then registerNPCFromHumanoid(obj) end
end

connect(Workspace.DescendantAdded, function(obj)
    if obj:IsA("Humanoid") then registerNPCFromHumanoid(obj) end
end)

connect(Workspace.DescendantRemoving, function(obj)
    if obj:IsA("Humanoid") then
        local model = obj.Parent
        if model then npcCache[model] = nil end
    end
end)

local currentTarget
local acquireClock = 0
local sightClock = 0
local cachedTargets = {}

local function getAimPart(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Head")
end

local function isAliveModel(model)
    if not model or not model.Parent then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0 and getAimPart(model) ~= nil
end

local function isAllowedTarget(model)
    if not isAliveModel(model) or model == LocalPlayer.Character then return false end
    local player = Players:GetPlayerFromCharacter(model)
    if player then return Settings.Players end
    return Settings.NPCs and model:GetAttribute("LockOnTargetable") ~= false
end

local sightParams = RaycastParams.new()
sightParams.FilterType = Enum.RaycastFilterType.Exclude

local function visibleToCamera(model, part)
    if not Settings.LineOfSight then return true end
    Camera = Workspace.CurrentCamera
    if not Camera or not part or not part.Parent then return false end
    sightParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = Workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, sightParams)
    return result == nil or result.Instance:IsDescendantOf(model)
end

local function collectTargets()
    local list, seen = {}, {}
    if Settings.Players then
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            if player ~= LocalPlayer and character and isAliveModel(character) then
                seen[character] = true
                table.insert(list, character)
            end
        end
    end
    if Settings.NPCs then
        for model in pairs(npcCache) do
            if model.Parent and not seen[model] and isAliveModel(model)
                and model ~= LocalPlayer.Character
                and model:GetAttribute("LockOnTargetable") ~= false then
                seen[model] = true
                table.insert(list, model)
            elseif not model.Parent then
                npcCache[model] = nil
            end
        end
    end
    return list
end

local function clearTarget(message)
    currentTarget = nil
    Marker.Adornee = nil
    Marker.Enabled = false
    Readout.Text = message or (Settings.LockOn and "TARGET  /  SEARCHING" or "TARGET  /  LOCK DISABLED")
end

local function getScreenDistance(model, center)
    if not Camera or not isAllowedTarget(model) then return nil end
    local part = getAimPart(model)
    if not part then return nil end
    local point, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen or point.Z <= 0 then return nil end
    local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
    if distance > Settings.FOV or not visibleToCamera(model, part) then return nil end
    return distance, part
end

local function findBestTarget(center, exclude)
    local bestModel, bestDistance = nil, Settings.FOV
    for _, model in ipairs(cachedTargets) do
        if model ~= exclude then
            local distance = getScreenDistance(model, center)
            if distance and distance < bestDistance then
                bestModel, bestDistance = model, distance
            end
        end
    end
    return bestModel
end

local function switchTarget(direction)
    Camera = Workspace.CurrentCamera
    if not Camera then return end
    cachedTargets = collectTargets()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local candidates = {}
    for _, model in ipairs(cachedTargets) do
        local distance = getScreenDistance(model, center)
        if distance then table.insert(candidates, {model = model, distance = distance}) end
    end
    table.sort(candidates, function(a, b) return a.distance < b.distance end)
    if #candidates == 0 then
        clearTarget("TARGET  /  NO VALID TARGETS")
        return
    end

    local currentIndex
    for i, entry in ipairs(candidates) do
        if entry.model == currentTarget then currentIndex = i break end
    end
    local nextIndex
    if currentIndex then
        nextIndex = ((currentIndex - 1 + direction) % #candidates) + 1
    else
        nextIndex = direction >= 0 and 1 or #candidates
    end
    currentTarget = candidates[nextIndex].model
end

connect(NextTargetButton.Activated, function() switchTarget(1) end)
connect(PreviousTargetButton.Activated, function() switchTarget(-1) end)

setLockOn = function(value)
    if Settings.LockOn == value then return end
    Settings.LockOn = value
    local button = ToggleButtons.LockOn
    if button then
        button.Text = value and "ON" or "OFF"
        button.BackgroundColor3 = value and accent() or PANEL2
        button.TextColor3 = value and BG or MUTED
    end
    if not value then
        clearTarget("TARGET  /  LOCK DISABLED")
    end
end

connect(UserInputService.InputBegan, function(input, gameProcessed)
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    if pendingKeybind then
        local action = pendingKeybind
        pendingKeybind = nil
        if input.KeyCode == Enum.KeyCode.Escape then
            KeybindButtons[action].Text = keyName(Keybinds[action])
            KeybindButtons[action].TextColor3 = accent()
            return
        end
        if input.KeyCode ~= Enum.KeyCode.Unknown then Keybinds[action] = input.KeyCode end
        KeybindButtons[action].Text = keyName(Keybinds[action])
        KeybindButtons[action].TextColor3 = accent()
        return
    end
    if gameProcessed or UserInputService:GetFocusedTextBox() then return end
    if input.KeyCode == Keybinds.ToggleLock then
        setLockOn(not Settings.LockOn)
    elseif input.KeyCode == Keybinds.NextTarget then
        switchTarget(1)
    elseif input.KeyCode == Keybinds.PreviousTarget then
        switchTarget(-1)
    elseif input.KeyCode == Keybinds.ToggleUI then
        Main.Visible = not Main.Visible
        Reopen.Visible = not Main.Visible
    end
end)

-- Noclip is optional and only affects the local character while enabled.
-- Original CanCollide values are restored when disabled or when the GUI is destroyed.
local originalCollision = {}
local function applyNoClip()
    local character = LocalPlayer.Character
    if not character then return end

    if Settings.NoClip then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                if originalCollision[part] == nil then
                    originalCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end
    else
        for part, canCollide in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
            originalCollision[part] = nil
        end
    end
end

connect(LocalPlayer.CharacterAdded, function()
    table.clear(originalCollision)
end)

RunService:UnbindFromRenderStep("MM2LockOnCamera")
RunService:BindToRenderStep("MM2LockOnCamera", Enum.RenderPriority.Camera.Value + 2, function(dt)
    Camera = Workspace.CurrentCamera
    applyNoClip()
    if not Camera then return end

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    Ring.Position = UDim2.fromOffset(center.X, center.Y)
    Ring.Size = UDim2.fromOffset(Settings.FOV * 2, Settings.FOV * 2)
    Ring.Visible = Settings.ShowFOV
    RingStroke.Color = accent()
    Readout.Position = UDim2.fromOffset(center.X, center.Y + Settings.FOV + 14)
    Readout.Visible = Settings.ShowMarker
    Readout.TextColor3 = accent()
    Marker.Enabled = false

    Status.Text = Settings.LockOn and "●  LOCK ACTIVE  /  TRACKING" or "●  LOCK DISABLED  /  READY"
    Status.TextColor3 = Settings.LockOn and accent() or MUTED

    if not Settings.LockOn then
        clearTarget()
        return
    end

    acquireClock += dt
    sightClock += dt
    if acquireClock >= 0.35 then
        acquireClock %= 0.35
        cachedTargets = collectTargets()
    end

    if currentTarget then
        local currentPart = getAimPart(currentTarget)
        local currentDistance
        if isAllowedTarget(currentTarget) and currentPart then
            local point, onScreen = Camera:WorldToViewportPoint(currentPart.Position)
            if onScreen and point.Z > 0 then
                currentDistance = (Vector2.new(point.X, point.Y) - center).Magnitude
            end
        end
        if not currentDistance or currentDistance > Settings.FOV then
            clearTarget("TARGET  /  TARGET LOST")
        end
    end

    if currentTarget and Settings.LineOfSight and sightClock >= 0.15 then
        sightClock = 0
        local part = getAimPart(currentTarget)
        if not part or not visibleToCamera(currentTarget, part) then
            clearTarget("TARGET  /  LINE OF SIGHT LOST")
        end
    end

    if not currentTarget then
        currentTarget = findBestTarget(center)
    end

    if currentTarget then
        local part = getAimPart(currentTarget)
        if part then
            local targetPlayer = Players:GetPlayerFromCharacter(currentTarget)
            local label = targetPlayer and targetPlayer.DisplayName or currentTarget.Name
            local point = Camera:WorldToViewportPoint(part.Position)
            local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
            Readout.Text = string.format("LOCKED  /  %s  /  %.0f PX", label, distance)

            if Settings.ShowMarker then
                Marker.Adornee = part
                Marker.Enabled = true
                local markerText = Marker:FindFirstChildOfClass("TextLabel")
                if markerText then markerText.TextColor3 = accent() end
            end
            -- Aim-assist only: smoothly adjust camera rotation while preserving
            -- the Roblox camera position and current CameraType.
            -- The character's root part and Humanoid.AutoRotate are never changed.
            local camPos = Camera.CFrame.Position
            local desiredCFrame = CFrame.lookAt(camPos, part.Position, Vector3.yAxis)
            local response = Settings.Strength -- higher = stronger/faster camera correction
            local alpha = 1 - math.exp(-response * math.max(dt, 0))
            Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, alpha)
        else
            clearTarget("TARGET  /  TARGET LOST")
        end
    else
        Readout.Text = "TARGET  /  SEARCHING"
    end
end)

connect(GUI.Destroying, function()
    Settings.NoClip = false
    applyNoClip()
    RunService:UnbindFromRenderStep("MM2LockOnCamera")
    for i = #Connections, 1, -1 do
        local connection = Connections[i]
        if connection and connection.Connected then connection:Disconnect() end
        Connections[i] = nil
    end
end)

